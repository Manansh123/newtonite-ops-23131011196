# Copy to .env (cp .env.example .env). Never commit .env.
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops
TEST_DATABASE_URL=postgresql://ops:ops@localhost:5432/ops_test
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4000
BCRYPT_ROUNDS=10

# Used by docker-compose.yml for the Postgres container
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops

# ---------------------------------------------------------------------------
# Production / hosting (leave commented for local development)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# JWT_SECRET must be >= 32 random characters in production, e.g.: openssl rand -hex 32
# DATABASE_URL must point at your hosted PostgreSQL.
#
# SEED_DEMO_DATA=true   # on first boot ONLY, seed demo data if the database has no users (demo deployments)
# SERVE_FRONTEND=true   # default in production: the API also serves the built UI (same origin => no CORS)
#
# Split deployment only (UI on a different origin than the API):
# CORS_ORIGIN=https://your-ui.example.com      # API: comma-separated list of allowed browser origins
# VITE_API_URL=https://your-api.example.com    # UI: set at BUILD time (frontend), no trailing slash
